<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Max_Upload_Not_Below_Target</fullName>
    <active>true</active>
    <errorConditionFormula
  >Max_Upload_Size_KB__c &lt; Target_Size_KB__c</errorConditionFormula>
    <errorDisplayField>Max_Upload_Size_KB__c</errorDisplayField>
    <errorMessage
  >Max Upload Size must be greater than or equal to Target Size.</errorMessage>
</ValidationRule>
