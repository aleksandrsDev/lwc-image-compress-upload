<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dimensions_Must_Be_Positive</fullName>
    <active>true</active>
    <errorConditionFormula
  >OR(Max_Width__c &lt;= 0, Max_Height__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Max_Width__c</errorDisplayField>
    <errorMessage
  >Max Width and Max Height must be greater than 0.</errorMessage>
</ValidationRule>
